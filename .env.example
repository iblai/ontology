# ============================================================
# .env.example — environment template for the iblai-ontology stack
#
# Copy to .env and fill in real values. NEVER commit real secrets.
#   cp .env.example .env
#
# Per-MCP-server credentials are split into .env.mcp / .env.canvas /
# .env.slate / .env.navigate / .env.ldap so each MCP container only sees
# the secrets it needs (credential isolation). The variables below cover
# all of them; distribute as appropriate.
# ============================================================

# PeopleSoft Oracle (read-only credentials provided by university)
PEOPLESOFT_DB_HOST=changeme.internal.university.edu
PEOPLESOFT_DB_PORT=1521
PEOPLESOFT_DB_NAME=CSPRD
PEOPLESOFT_RO_USER=iblai_readonly
PEOPLESOFT_RO_PASSWORD=<provided-by-university>

# Canvas LMS
CANVAS_BASE_URL=https://changeme.instructure.com
CANVAS_API_TOKEN=<generated-by-canvas-admin>

# Slate CRM
SLATE_BASE_URL=https://apply.changeme.edu
SLATE_API_KEY=<provided-by-slate-admin>

# Local iblai-ontology DB
ONTOLOGY_DB_PASSWORD=<generated-during-setup>

# Registry encryption key (Fernet). Prefer the Compose secret file over an env var:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" > secrets/ontology_credential_key
#   chmod 600 secrets/ontology_credential_key
# ONTOLOGY_CREDENTIAL_KEY_FILE=./secrets/ontology_credential_key   # host-side `ontology` CLI
# ONTOLOGY_CREDENTIAL_KEY=                                        # alternative: the key itself

# Microsoft Entra ID
ENTRA_TENANT_ID=<university-tenant-id>
ENTRA_CLIENT_ID=<iblai-ontology-app-client-id>

# Public domain served by Caddy (e.g., ontology.university.edu lives under this)
ONTOLOGY_DOMAIN=changeme.edu

# Caddy will auto-provision TLS via Let's Encrypt
# or use a university-provided certificate.

# ============================================================
# Console REST API (DRF) — consumed by the Ontology Console SPA
# ============================================================
# Auth accepts an Entra Bearer JWT (admin_dashboard role) OR an ibl.ai DM token.
# The DM scheme is verified against the DM + LMS endpoints below; leave both
# unset to disable it. Any platform's active admin is accepted (platform-agnostic).
# ONTOLOGY_DM_URL=https://your-dm-host
# ONTOLOGY_LMS_URL=https://api.iblai.org/lms
# ONTOLOGY_DM_VERIFY_TTL=300
# Scope console admin to specific platforms (matched by key/org). Unset = the
# platform-agnostic default (any platform's admin). Set this when the DM/LMS
# above is the shared ibl.ai platform, so an unrelated platform's admin cannot
# control this on-prem ontology.
# ONTOLOGY_ADMIN_PLATFORMS=your-platform-key,another-key

# ============================================================
# Record store — where the registry and run history live
# ============================================================
# local (default): this backend's database. dm: the DM platform database of
# IBLAI_ORG (DM PR #3103); create it once with `ontology platform database`.
# The student-data cache, memory files and vector index stay local either way.
# ONTOLOGY_DATA_STORE=local
# The DM the store (and `ontology platform`) talks to — the same DM as
# ONTOLOGY_DM_URL above, possibly by another hostname.
# IBLAI_BASE_URL=https://base.manager.iblai.app
# IBLAI_ORG=your-platform-key
# A platform API key with IBLAI_AUTH_SCHEME=Api-Token (a DM Token expires after
# 14 days). Its owner must be a platform admin, or the key must hold
# Ibl.Mentor/Database/* and Ibl.Mentor/DatabaseAccess/* when RBAC is on.
# In dm, ONTOLOGY_ADMIN_PLATFORMS defaults to IBLAI_ORG.
# IBLAI_ADMIN_TOKEN=
# IBLAI_AUTH_SCHEME=Api-Token

# Browser origins allowed to call the API cross-origin (the console's origin).
# ONTOLOGY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local dev only: treat anonymous requests as a synthetic admin (NEVER in prod).
# ONTOLOGY_API_DEV_ALLOW_ANON=false
