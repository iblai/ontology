# No setting names the ibl.ai platform: the console works on the one the person signs in to.

# One codebase, three ways to run it (docs/network.md):
# - one host (pnpm dev): pages and server half on one origin. Neither NEXT_PUBLIC_ONTOLOGY_RELAY
#   nor ONTOLOGY_SETUP_CODE is set.
# - pages (Vercel): NEXT_PUBLIC_ONTOLOGY_RELAY=1, the ibl.ai endpoints and the console's origin.
#   None of the server half's settings: the pages hold no engine key and no file.
# - server (a client's own machine): deploy/install.sh writes the server half's settings and
#   ONTOLOGY_SETUP_CODE (docs/install.md).

# ibl.ai endpoints. Leave unset for the hosted platform (api.iblai.app / login.iblai.app).
# In the closed deployment point the API at the allow-listed backend (docs/network.md):
# NEXT_PUBLIC_API_BASE_URL=https://ext.ibl.ai
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app

# The console's public origin. On one host agents call <this origin>/<platform>/<slug>/mcp.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pages only: 1 = serve the pages and forward every /api/host/* call to the platform's server.
# Fixed when the app is built.
# NEXT_PUBLIC_ONTOLOGY_RELAY=1

# --- The server half: one host, or a client's server ---

# AO_URL and AO_API_KEY are the host's own engine. It serves one platform: the first whose console
# admin uses the host (on a client's server, the one its link was opened for), kept in
# $ONTOLOGY_HOME/engine-platform. On one host any other platform needs its own engine, written to
# $ONTOLOGY_HOME/platforms/<platform>/engine.json.
# The engine's web app, moved to this port by deploy/auto-ontology.override.yml.
AO_URL=http://127.0.0.1:3100

# The engine's service token, minted once by an engine admin under API Tokens (by the installer on
# a client's server).
AO_API_KEY=

# Where the host keeps, per platform, server configs, revisions, logs and the secrets file.
ONTOLOGY_HOME=.ontology

# Optional: a Toolbox binary to run instead of the one pnpm installs.
# TOOLBOX_BIN=

# Optional: the ibl.ai DM address, read at run time. Else NEXT_PUBLIC_API_BASE_URL + /dm, which the
# build fixes.
# ONTOLOGY_DM_URL=https://ext.ibl.ai/dm

# Server only: the installer's one-time code. The server answers 503 until an admin opens its link,
# then serves that admin's platform only.
# ONTOLOGY_SETUP_CODE=

# 1 = skip SSO and use a fixed demo session (UI review, screenshots). SDK panels show a notice.
NEXT_PUBLIC_DEMO=0

# 0 = hide the prototype walkthrough stepper.
NEXT_PUBLIC_WALKTHROUGH=1
