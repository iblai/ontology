# A server with an engine of its own (AO_URL) serves one ibl.ai platform: ONTOLOGY_PLATFORM.
# Without an engine of its own it serves any platform the person signs in to.

# One codebase, three ways to run it (docs/network.md):
# - a client's server: deploy/iblai-ontology.service sets the server half's settings itself
#   (deploy/compose.yaml, for the console as an image); this file is not for it (docs/install.md).
# - pages hosted elsewhere: NEXT_PUBLIC_ONTOLOGY_RELAY=1, the ibl.ai endpoints and the console's
#   origin. None of the server half's settings: the pages hold no engine key and no file.
# - one host (pnpm dev): pages and server half on one origin, from this file as .env.local.

# ibl.ai endpoints. Leave unset for the hosted platform (api.iblai.app / login.iblai.app).
# In the closed deployment point the API at the allow-listed backend (docs/network.md):
# NEXT_PUBLIC_API_BASE_URL=https://ext.ibl.ai
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app

# The console's public origin. On one host agents call <this origin>/<platform>/<slug>/mcp.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pages only: 1 = serve the pages and forward every /api/host/* call to the platform's server.
# Fixed when the app is built.
# NEXT_PUBLIC_ONTOLOGY_RELAY=1

# --- The server half ---

# The host's own engine: its web app, moved to this port by deploy/auto-ontology.override.yml.
# Without it each platform needs its own engine, on another machine, written to
# $ONTOLOGY_HOME/platforms/<platform>/engine.json.
AO_URL=http://127.0.0.1:3100

# The key of the ibl.ai platform the engine in AO_URL belongs to; the only platform served.
# Required with AO_URL: the server refuses to start without it.
ONTOLOGY_PLATFORM=

# Optional: the engine's service token, minted by an engine admin under API Tokens. Without it the
# server signs in as the engine's admin (below), makes its own and keeps it in
# $ONTOLOGY_HOME/engine-key.
AO_API_KEY=

# The engine admin the server signs in as when AO_API_KEY is empty, and a file holding the password.
# AO_ADMIN_EMAIL=
# AO_ADMIN_PASSWORD_FILE=

# The origin the engine trusts at sign-in (its APP_URL), when not AO_URL's own.
# AO_ORIGIN=http://localhost:3100

# Where the host keeps, per platform, server configs, revisions, logs and the secrets file.
ONTOLOGY_HOME=.ontology

# Optional: localhost = this server answers on its own machine only, and an HTTP API on this machine
# may be connected when run with pnpm start. pnpm dev needs nothing.
# ONTOLOGY_HOST=localhost

# Optional: the one folder a Filesystem source may read. Unset, the home folder of the account the
# server runs as.
# ONTOLOGY_LOCAL_ROOT=

# Optional: a Toolbox binary to run instead of the one pnpm installs.
# TOOLBOX_BIN=

# Optional: the ibl.ai DM address, read at run time. Else NEXT_PUBLIC_API_BASE_URL + /dm, which the
# build fixes.
# ONTOLOGY_DM_URL=https://ext.ibl.ai/dm

# Optional: a file holding the key the engine presents on /internal/models/v1. Unset, the route
# answers 404.
# ONTOLOGY_MODEL_KEY_FILE=

# Optional: turns the engine's semantic features on, through the route above. Without it the
# route answers 403 and nothing leaves the host.
# OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# 1 = skip SSO and use a fixed demo session (UI review, screenshots). SDK panels show a notice.
NEXT_PUBLIC_DEMO=0

# 0 = hide the prototype walkthrough stepper.
NEXT_PUBLIC_WALKTHROUGH=1
