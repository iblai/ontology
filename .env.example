# ibl.ai organization this console belongs to (listed on https://login.iblai.app/me).
# Never "main" (the shared org) or a placeholder.
NEXT_PUBLIC_MAIN_TENANT_KEY=your-platform

# ibl.ai endpoints. Leave unset for the hosted platform (api.iblai.app / login.iblai.app).
# In the closed deployment point the API at the allow-listed backend (docs/network.md):
# NEXT_PUBLIC_API_BASE_URL=https://ext.ibl.ai
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app

# Server-side only (route handlers / gateway). Never NEXT_PUBLIC_.
# IBLAI_API_KEY=

# 1 = skip SSO and use a fixed demo session (UI review, screenshots). SDK panels show a notice.
NEXT_PUBLIC_DEMO=0

# 0 = hide the prototype walkthrough stepper.
NEXT_PUBLIC_WALKTHROUGH=1
