# ============================================================
# .env.example — environment template for the iblai-ontology stack
#
# Copy to .env and fill in real values. NEVER commit real secrets.
#   cp .env.example .env
#
# Per-MCP-server credentials are split into .env.mcp / .env.canvas /
# .env.slate / .env.navigate / .env.ldap / .env.twenty so each MCP container only sees
# the secrets it needs (credential isolation). The variables below cover
# all of them; distribute as appropriate.
# ============================================================

# PeopleSoft Oracle (read-only credentials provided by university)
PEOPLESOFT_DB_HOST=changeme.internal.university.edu
PEOPLESOFT_DB_PORT=1521
PEOPLESOFT_DB_NAME=CSPRD
PEOPLESOFT_RO_USER=iblai_readonly
PEOPLESOFT_RO_PASSWORD=<provided-by-university>

# Canvas LMS
CANVAS_BASE_URL=https://changeme.instructure.com
CANVAS_API_TOKEN=<generated-by-canvas-admin>

# Slate CRM
SLATE_BASE_URL=https://apply.changeme.edu
SLATE_API_KEY=<provided-by-slate-admin>

# Twenty CRM on its cloud (a self-hosted Twenty is read as a generic-postgres source instead)
TWENTY_BASE_URL=https://api.twenty.com
TWENTY_API_KEY=<created-in-twenty-settings-apis>

# Local iblai-ontology DB
ONTOLOGY_DB_PASSWORD=<generated-during-setup>

# Registry encryption key (Fernet). Prefer the Compose secret file over an env var:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" > secrets/ontology_credential_key
#   chmod 600 secrets/ontology_credential_key
# ONTOLOGY_CREDENTIAL_KEY_FILE=./secrets/ontology_credential_key   # host-side `ontology` CLI
# ONTOLOGY_CREDENTIAL_KEY=                                        # alternative: the key itself

# Microsoft Entra ID
ENTRA_TENANT_ID=<university-tenant-id>
ENTRA_CLIENT_ID=<iblai-ontology-app-client-id>

# The ibl.ai platform's service token for the MCP gateway: it calls with
# `Authorization: Bearer <token>` and the role in X-Iblai-Role. 32+ characters
# (openssl rand -hex 32). Unset = Entra JWTs only.
# ONTOLOGY_SERVICE_TOKEN=
# The gateway's public URL (a tunnel, or the Caddy edge); the console probes it.
# ONTOLOGY_GATEWAY_URL=https://ontology.changeme.edu/mcp

# Public domain served by Caddy (e.g., ontology.university.edu lives under this)
ONTOLOGY_DOMAIN=changeme.edu

# Caddy will auto-provision TLS via Let's Encrypt
# or use a university-provided certificate.

# ============================================================
# Console REST API (DRF) — consumed by the Ontology Frontend
# ============================================================
# Auth accepts an Entra Bearer JWT (admin_dashboard role) OR an ibl.ai platform
# token, the one credential the Ontology Frontend sends. The token is verified
# against the platform below; leave it unset to disable that scheme.
# ONTOLOGY_DM_URL=https://your-dm-host
# ONTOLOGY_DM_VERIFY_TTL=300
# The platforms, by key, whose admins may use the console. Unset = this
# backend's own platform (IBLAI_ORG below); with neither set, any platform's
# admin is taken.
# ONTOLOGY_ADMIN_PLATFORMS=your-platform-key,another-key

# ============================================================
# Platform store: where roles, sync schedules and the service registry live
# ============================================================
# local (default): config/roles.yaml, config/sync-schedules.yaml and this
# backend's database. dm: the ibl.ai platform of IBLAI_ORG. There the roles are
# the platform's own RBAC roles and roles.yaml is never read: a platform with
# no ontology role gets the example roles at its first console sign-in, and
# `ontology roles import <file>` copies a file's in. Copy the schedules in once
# with `ontology sync import`.
# Sync runs, the audit log, the student-data cache, memory files and vector
# index stay on this host either way.
# ONTOLOGY_DATA_STORE=local
# Seconds a backend process keeps the roles it read from the platform (dm).
# ONTOLOGY_ROLES_TTL=60
# The platform the store (and `ontology platform`) talks to: the same one as
# ONTOLOGY_DM_URL above, possibly by another hostname.
# IBLAI_BASE_URL=https://base.manager.iblai.app
# IBLAI_ORG=your-platform-key
# A platform API key in owner mode with IBLAI_AUTH_SCHEME=Api-Token (a platform
# Token expires after 14 days). Its owner is an admin of the platform. For the
# roles (dm) the platform must have its `Custom RBAC Manager` policy; one
# created before that policy existed gets it when `seed_rbac_data` is run again.
# IBLAI_ADMIN_TOKEN=
# IBLAI_AUTH_SCHEME=Api-Token
# The hosted Ontology Frontend (ontology.ibl.ai) finds this backend by the
# address it records in the platform, in either store mode:
#   ontology platform address --url https://ontology.changeme.edu

# Browser origins allowed to call the API cross-origin (the console's origin).
# ONTOLOGY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local dev only: treat anonymous requests as a synthetic admin (NEVER in prod).
# ONTOLOGY_API_DEV_ALLOW_ANON=false
