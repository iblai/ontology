# Ontology Console — environment

# Server-only. Three modes, by these two variables:
#
# 1. Neither set → the console serves its in-memory demo data from the Next route
#    handlers under /api/ontology (no backend, no auth).
# 2. ONTOLOGY_API_URL set → every /api/ontology/* call is forwarded to that one
#    backend with the caller's `Authorization: Token <dm_token>` (stored by the
#    ibl.ai SSO flow).
# ONTOLOGY_API_URL=http://localhost:8000
# 3. ONTOLOGY_MULTI_PLATFORM=true (and no ONTOLOGY_API_URL) → one console for every
#    platform, as at ontology.ibl.ai. Each call goes to the backend of the signed-in
#    admin's own platform: the address that backend recorded there with
#    `ontology platform address --url https://…`, read with the admin's token. It must
#    be a public https address. A platform without one, and a member who is not its
#    admin, get a notice instead of the pages.
# ONTOLOGY_MULTI_PLATFORM=true
#
# The browser never calls a backend directly, so no CORS.

# ibl.ai SSO (wired via /iblai-vibe-auth)
# Leave NEXT_PUBLIC_MAIN_TENANT_KEY unset in mode 3: the platform is the one signed in to.
# NEXT_PUBLIC_MAIN_TENANT_KEY=
# NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app
# NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
