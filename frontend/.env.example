# Ontology Console — environment

# Server-only. Unset or empty → the console serves its in-memory demo data from
# the Next route handlers under /api/ontology (no backend, no auth).
# Set → every /api/ontology/* call is forwarded there with the caller's
# `Authorization: Token <dm_token>` and `X-Edx-Jwt` headers (stored by the
# ibl.ai SSO flow). The browser never calls the backend directly, so no CORS.
# ONTOLOGY_API_URL=http://localhost:8000
# Where the Configuration page reads the backend's YAML files from (forwarded mode only).
# ONTOLOGY_ROOT=../ontology

# ibl.ai SSO (wired via /iblai-vibe-auth)
# NEXT_PUBLIC_MAIN_TENANT_KEY=
# NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app
# NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
