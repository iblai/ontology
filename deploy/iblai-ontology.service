# ibl.ai/ontology built from source in /opt/iblai-ontology/repo (docs/install.md).
# NVIDIA's engine, its database and Caddy run beside it from compose.yaml.
[Unit]
Description=ibl.ai/ontology

[Service]
# exec: a start that cannot run, or lacks its secrets, is reported by systemctl.
Type=exec
User=ontology
WorkingDirectory=/opt/iblai-ontology/repo
# The settings Compose reads too: ONTOLOGY_PLATFORM, ONTOLOGY_DM_URL and the OPENAI_* names.
EnvironmentFile=/opt/iblai-ontology/.env
Environment=NEXT_TELEMETRY_DISABLED=1
# What `pnpm start` passes from pnpm-workspace.yaml.
Environment=NODE_OPTIONS=--no-experimental-webstorage
# The console's own files: /var/lib/ontology.
StateDirectory=ontology
StateDirectoryMode=0700
Environment=ONTOLOGY_HOME=/var/lib/ontology
# NVIDIA's engine, where compose.yaml runs it; the console makes its own key to it.
Environment=AO_URL=http://127.0.0.1:3100 AO_ORIGIN=http://localhost:3100
Environment=AO_ADMIN_EMAIL=admin@ontology.local
# Two of the secrets Compose generated, read from its volume by root as the service starts.
LoadCredential=admin-password:/var/lib/docker/volumes/iblai-ontology-console_secrets/_data/admin-password
LoadCredential=model-key:/var/lib/docker/volumes/iblai-ontology-console_secrets/_data/model-key
Environment=AO_ADMIN_PASSWORD_FILE=/run/credentials/iblai-ontology.service/admin-password
Environment=ONTOLOGY_MODEL_KEY_FILE=/run/credentials/iblai-ontology.service/model-key
# Loopback only: Caddy is the one way in, and next start listens everywhere unless told.
ExecStart=/home/ontology/.local/bin/mise exec -- node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
