{
  "id": "clever",
  "name": "Clever",
  "abbr": "Cl",
  "color": "#4274F6",
  "baseUrl": "https://api.clever.com/v3.0",
  "example": "https://api.clever.com/v3.0",
  "hint": "A district-app token from your Clever App Dashboard.",
  "auth": {
    "header": "Authorization: Bearer "
  },
  "sources": [
    {
      "url": "https://raw.githubusercontent.com/Clever/swagger-api/master/v3.0.yml",
      "version": "3.0.0"
    }
  ],
  "endpoints": [
    {
      "name": "list_districts",
      "method": "GET",
      "path": "/districts",
      "description": "Returns the district this token belongs to.",
      "query": []
    },
    {
      "name": "list_schools",
      "method": "GET",
      "path": "/schools",
      "description": "Lists the district’s schools.",
      "query": ["limit", "starting_after"]
    },
    {
      "name": "get_school",
      "method": "GET",
      "path": "/schools/{id}",
      "description": "Returns one school.",
      "query": []
    },
    {
      "name": "list_school_users",
      "method": "GET",
      "path": "/schools/{id}/users",
      "description": "Lists a school’s staff, students and teachers; role picks one kind.",
      "query": ["role", "limit", "starting_after"]
    },
    {
      "name": "list_users",
      "method": "GET",
      "path": "/users",
      "description": "Lists users: students, teachers, staff, district admins and contacts; role picks one kind.",
      "query": ["role", "limit", "starting_after"]
    },
    {
      "name": "get_user",
      "method": "GET",
      "path": "/users/{id}",
      "description": "Returns one user.",
      "query": []
    },
    {
      "name": "list_user_sections",
      "method": "GET",
      "path": "/users/{id}/sections",
      "description": "Lists the sections (classes) a student or teacher is in.",
      "query": ["limit", "starting_after"]
    },
    {
      "name": "list_students_of",
      "method": "GET",
      "path": "/users/{id}/mystudents",
      "description": "Lists the students of a teacher or a contact.",
      "query": ["limit", "starting_after"]
    },
    {
      "name": "list_teachers_of",
      "method": "GET",
      "path": "/users/{id}/myteachers",
      "description": "Lists a student’s teachers.",
      "query": ["limit", "starting_after"]
    },
    {
      "name": "list_sections",
      "method": "GET",
      "path": "/sections",
      "description": "Lists sections (classes).",
      "query": ["limit", "starting_after"]
    },
    {
      "name": "get_section",
      "method": "GET",
      "path": "/sections/{id}",
      "description": "Returns one section.",
      "query": []
    },
    {
      "name": "list_section_users",
      "method": "GET",
      "path": "/sections/{id}/users",
      "description": "Lists a section’s students and teachers; role picks one kind.",
      "query": ["role", "limit", "starting_after"]
    },
    {
      "name": "list_courses",
      "method": "GET",
      "path": "/courses",
      "description": "Lists courses.",
      "query": ["limit", "starting_after"]
    },
    {
      "name": "list_terms",
      "method": "GET",
      "path": "/terms",
      "description": "Lists terms.",
      "query": ["limit", "starting_after"]
    }
  ]
}
